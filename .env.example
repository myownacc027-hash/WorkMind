# PostgreSQL
POSTGRES_DB=workmind
POSTGRES_USER=workmind
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://workmind:change_me@localhost:5432/workmind

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=workmind_chunks

# Local multilingual embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_MAX_CHARS=500
CHUNK_OVERLAP_CHARS=80
WORKER_MAX_ATTEMPTS=3

# Local storage
WORKMIND_HOME=C:/AIKnowledge

# Outlook collection
OUTLOOK_ACCOUNT_SMTP=user@example.com
OUTLOOK_MAILBOX_NAME=user@example.com
OUTLOOK_LOOKBACK_DAYS=90
OUTLOOK_FOLDERS=Inbox,Sent Items
OUTLOOK_MAX_MESSAGES_PER_FOLDER=0
OUTLOOK_SAVE_ATTACHMENTS=true
OUTLOOK_SAVE_RAW_JSON=true


# Daily reconciliation protects against messages that Outlook downloads
# late with an older ReceivedTime/SentOn timestamp.
MAIL_RECONCILIATION_ENABLED=true
MAIL_RECONCILIATION_DAYS=14
MAIL_RECONCILIATION_INTERVAL_HOURS=24
MAIL_RECONCILIATION_STALE_HOURS=36
MAIL_RECONCILIATION_MAX_PER_FOLDER=0

# Logging
LOG_LEVEL=INFO


# Persistent local embedding service
EMBEDDING_SERVICE_ENABLED=true
EMBEDDING_SERVICE_URL=http://127.0.0.1:8765
EMBEDDING_SERVICE_HOST=127.0.0.1
EMBEDDING_SERVICE_PORT=8765
EMBEDDING_SERVICE_TIMEOUT_SECONDS=300
EMBEDDING_SERVICE_FALLBACK_LOCAL=true


# Historical corporate mail import
HISTORY_PRIMARY_STORE=user@example.com
HISTORY_ARCHIVE_STORE=Archive Mailbox
# Comma-separated names excluded from recursive history import.
# HISTORY_EXCLUDED_FOLDERS=Удаленные,Deleted Items,Нежелательная почта,Junk E-mail,Спам,Ошибки синхронизации,Sync Issues,Исходящие,Outbox,Черновики,Drafts,Журнал бесед,Conversation History


# Attachment extraction
ATTACHMENT_SUPPORTED_EXTENSIONS=.pdf,.docx,.xlsx,.xlsm,.pptx,.txt,.md,.csv,.json,.xml,.html,.htm,.log
# ATTACHMENT_MAX_BYTES=104857600
# ATTACHMENT_MAX_EXTRACTED_CHARS=5000000


# Unified hybrid search
# HYBRID_SEARCH_CANDIDATE_LIMIT=400
# HYBRID_SEARCH_SNIPPETS_PER_SOURCE=3
# HYBRID_SEARCH_SNIPPET_CHARS=1200
# HYBRID_SEARCH_RRF_K=60


# Standalone document ingestion
DOCUMENT_SUPPORTED_EXTENSIONS=.pdf,.docx,.xlsx,.xlsm,.pptx,.txt,.md,.csv,.json,.xml,.html,.htm,.log
# DOCUMENT_MAX_BYTES=262144000
# DOCUMENT_MAX_EXTRACTED_CHARS=10000000

# DOCUMENT_IMPORT_STALE_MINUTES=60
# DOCUMENT_STATUS_RECENT_ERROR_LIMIT=10

# Structured-knowledge extraction queue and optional background provider.
KNOWLEDGE_EXTRACTION_ENABLED=true
KNOWLEDGE_EXTRACTION_AUTO_QUEUE=true
KNOWLEDGE_EXTRACTION_VERSION=wm-ke-v2
KNOWLEDGE_EXTRACTION_MIN_CHARS=160
KNOWLEDGE_EXTRACTION_LEASE_MINUTES=30
KNOWLEDGE_EXTRACTION_MAX_ATTEMPTS=5
KNOWLEDGE_EXTRACTION_MAX_CONTEXT_CHARS=60000
KNOWLEDGE_EXTRACTION_MAX_CHUNKS=80
KNOWLEDGE_EXTRACTION_THREAD_MESSAGES=12
KNOWLEDGE_IDENTITY_MAX_CANDIDATES=8
KNOWLEDGE_IDENTITY_EXACT_QUERY_LIMIT=60
KNOWLEDGE_IDENTITY_EXACT_PHRASE_LIMIT=600
KNOWLEDGE_IDENTITY_SEMANTIC_SOURCE_LIMIT=20
KNOWLEDGE_IDENTITY_SEMANTIC_THRESHOLD=0.58
KNOWLEDGE_IDENTITY_LEXICAL_MIN_SCORE=0.62
KNOWLEDGE_IDENTITY_LEXICAL_SCAN_LIMIT=300
KNOWLEDGE_IDENTITY_SEMANTIC_CHUNK_LIMIT=60
KNOWLEDGE_IDENTITY_SEMANTIC_EVIDENCE_LIMIT=240
KNOWLEDGE_IDENTITY_SEMANTIC_ENTITY_LIMIT=60
KNOWLEDGE_IDENTITY_ACTIVE_CLAIMS_PER_ENTITY=60
KNOWLEDGE_IDENTITY_MANDATORY_CLAIMS_SAFETY_CAP=200
KNOWLEDGE_IDENTITY_RECENT_CLAIMS_PER_ENTITY=60
KNOWLEDGE_IDENTITY_RECENT_EVENTS_PER_ENTITY=30
KNOWLEDGE_IDENTITY_DUPLICATE_RISK_THRESHOLD=0.78
KNOWLEDGE_EXTRACTION_QUALITY_HISTORY_LIMIT=50
# agent = process through WorkMind MCP; openai = local background Responses API worker.
KNOWLEDGE_EXTRACTION_PROVIDER=agent
KNOWLEDGE_EXTRACTION_AUTO_APPLY=false
KNOWLEDGE_EXTRACTION_MODEL=gpt-5-mini
KNOWLEDGE_EXTRACTION_API_BASE=https://api.openai.com/v1
KNOWLEDGE_EXTRACTION_API_KEY=
KNOWLEDGE_EXTRACTION_REMOTE_CONSENT=false
KNOWLEDGE_EXTRACTION_TIMEOUT_SECONDS=120
